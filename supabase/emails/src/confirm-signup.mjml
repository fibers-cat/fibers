<!-- supabase/emails/src/confirm-signup.mjml -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#20242c" padding="0 0 8px">
          Confirma la teva adreça electrònica
        </mj-text>
        <mj-text>
          Segueix l'enllaç a continuació per confirmar aquesta adreça electrònica i completar el registre.
        </mj-text>
        <mj-button href="{{ .ConfirmationURL }}" align="left">
          Confirma l'adreça electrònica
        </mj-button>
        <mj-text font-size="12px" color="#8a929d">
          Si no has sol·licitat aquest correu, pots ignorar-lo amb tranquil·litat.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
