<!-- supabase/emails/src/change-email.mjml -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#20242c" padding="0 0 8px">
          Confirma la teva nova adreça electrònica
        </mj-text>
        <mj-text>
          Segueix l'enllaç a continuació per confirmar {{ .NewEmail }} com a nova adreça electrònica.
        </mj-text>
        <mj-button href="{{ .ConfirmationURL }}" align="left">
          Confirma la nova adreça
        </mj-button>
        <mj-text font-size="12px" color="#8a929d">
          Si no has sol·licitat aquest canvi, pots ignorar aquest correu amb tranquil·litat.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
