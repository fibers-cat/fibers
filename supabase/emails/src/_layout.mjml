<!-- supabase/emails/src/_layout.mjml -->
<mjml>
  <mj-head>
    <mj-title>Fibers</mj-title>
    <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif" />
      <mj-text padding="0 0 16px" line-height="1.6" color="#20242c" />
      <mj-button background-color="#ef555a" color="#ffffff" font-weight="700" border-radius="999px" padding="12px 24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f6f7f9">
    <mj-section padding="32px 16px 16px">
      <mj-column>
        <mj-image width="160px" src="https://fibers.cat/images/fibers-heart.svg" alt="Fibers" align="left" />
      </mj-column>
    </mj-section>
    <!--CONTENT-->
    <mj-section padding="0 16px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#8a929d" align="center">
          © Fibers · <a href="https://fibers.cat" style="color:#8a929d;">fibers.cat</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
