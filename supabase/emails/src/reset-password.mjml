<!-- supabase/emails/src/reset-password.mjml -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#20242c" padding="0 0 8px">
          Restableix la teva contrasenya
        </mj-text>
        <mj-text>
          Hem rebut una sol·licitud per restablir la contrasenya. Segueix l'enllaç a continuació per triar-ne una de nova.
        </mj-text>
        <mj-button href="{{ .ConfirmationURL }}" align="left">
          Restableix la contrasenya
        </mj-button>
        <mj-text font-size="12px" color="#8a929d">
          Si no has sol·licitat aquest canvi, pots ignorar aquest correu amb tranquil·litat.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
