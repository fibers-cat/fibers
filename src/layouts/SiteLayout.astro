---
import SiteNavigation from '@/components/SiteNavigation';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description = 'Materials d’estudi compartits per la comunitat d’estudiants de la FIB.',
  noindex = false,
  ogImage = '/images/og-fibers.png',
} = Astro.props;
const currentPath = Astro.url.pathname;
const site = Astro.site ?? new URL('https://fibers.cat');
const siteOrigin = site.origin;
const canonicalUrl = new URL(currentPath, site).href;
const imageUrl = new URL(ogImage, site).href;
const documentTitle = `${title} | Fibers`;

const structuredData = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteOrigin}/#website`,
          url: `${siteOrigin}/`,
          name: 'Fibers',
          alternateName: 'Fibers FIB',
          inLanguage: 'ca-ES',
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: documentTitle,
          description,
          inLanguage: 'ca-ES',
          isPartOf: { '@id': `${siteOrigin}/#website` },
        },
        ...(currentPath === '/'
          ? [{
              '@type': 'Organization',
              '@id': `${siteOrigin}/#organization`,
              name: 'Fibers',
              url: `${siteOrigin}/`,
              logo: `${siteOrigin}/images/fibers-heart.png`,
              description: 'Projecte comunitari de materials d’estudi per a la Facultat d’Informàtica de Barcelona.',
              contactPoint: {
                '@type': 'ContactPoint',
                contactType: 'Contacte',
                url: `${siteOrigin}/contacte/`,
                availableLanguage: ['Catalan'],
              },
            }]
          : []),
      ],
    };
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f9" />
    <meta name="description" content={description} />
    <meta name="author" content="Fibers" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/images/fibers-heart-alt.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:site_name" content="Fibers" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fibers, materials d’estudi compartits per a la FIB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Fibers, materials d’estudi compartits per a la FIB" />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    {import.meta.env.PROD && (
      <script
        defer
        src="/scripts/umami.js"
        data-website-id="78833c4a-67ac-4ac3-8172-899db82a84f9"
        data-host-url="https://umami.qu4k3.com"
      ></script>
    )}
  </head>
  <body>
    <SiteNavigation client:load currentPath={currentPath} />
    <main class="site-main">
      <slot />
      <footer class="site-footer">
        <div><span>© 2016-{new Date().getFullYear()} Fibers</span><span>Recursos compartits per a la comunitat FIB</span></div>
        <nav aria-label="Enllaços del peu de pàgina">
          <a href="/guia/">Com funciona</a>
          <a href="/condicions/">Condicions d’ús</a>
          <a href="/contacte/">Contacte</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
