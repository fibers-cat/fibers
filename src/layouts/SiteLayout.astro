---
import SiteNavigation from '@/components/shared/SiteNavigation';
import {
  canonicalPath,
  defaultLocale,
  getLocaleFromUrl,
  isLocale,
  localizePath,
  locales,
  localeNames,
  useTranslations,
  type Locale,
} from '@/i18n';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  noindex = false,
  ogImage = '/images/og-fibers.png',
} = Astro.props;

const currentLocale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);
const description = Astro.props.description ?? t('meta.siteDescription');

const currentPath = Astro.url.pathname;
// Canonical (Catalan) logical path, e.g. `/es/acerca/` → `/sobre/`.
const basePath = canonicalPath(currentPath, currentLocale);
const site = Astro.site ?? new URL('https://fibers.cat');
const siteOrigin = site.origin;
const canonicalUrl = new URL(localizePath(basePath, currentLocale), site).href;
const imageUrl = new URL(ogImage, site).href;
const documentTitle = `${title} | Fibers`;
const ogLocale = currentLocale === 'ca' ? 'ca_ES' : 'es_ES';
const alternatePaths = locales.map((locale) => ({
  locale,
  href: new URL(localizePath(basePath, locale), site).href,
}));

const structuredData = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteOrigin}/#website`,
          url: `${siteOrigin}/`,
          name: 'Fibers',
          alternateName: 'Fibers FIB',
          inLanguage: currentLocale === 'ca' ? 'ca-ES' : 'es-ES',
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: documentTitle,
          description,
          inLanguage: currentLocale === 'ca' ? 'ca-ES' : 'es-ES',
          isPartOf: { '@id': `${siteOrigin}/#website` },
        },
        ...(basePath === '/'
          ? [{
              '@type': 'Organization',
              '@id': `${siteOrigin}/#organization`,
              name: 'Fibers',
              url: `${siteOrigin}/`,
              logo: `${siteOrigin}/images/fibers-heart.png`,
              description: t('org.description'),
              contactPoint: {
                '@type': 'ContactPoint',
                contactType: t('org.contactType'),
                url: `${siteOrigin}${localizePath('/contacte/', currentLocale)}`,
                availableLanguage: Object.values(localeNames),
              },
            }]
          : []),
      ],
    };
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f9" />
    <meta name="description" content={description} />
    <meta name="author" content="Fibers" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {alternatePaths.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(basePath, defaultLocale), site).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/images/fibers-heart-alt.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {locales
      .filter((locale) => locale !== currentLocale)
      .map((locale) => (
        <meta
          property="og:locale:alternate"
          content={locale === 'ca' ? 'ca_ES' : 'es_ES'}
        />
      ))}
    <meta property="og:site_name" content="Fibers" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.imageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={t('meta.imageAlt')} />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    {import.meta.env.PROD && (
      <script
        defer
        src="/scripts/umami.js"
        data-website-id="78833c4a-67ac-4ac3-8172-899db82a84f9"
        data-host-url="https://umami.qu4k3.com"
      ></script>
    )}
  </head>
  <body>
    <SiteNavigation client:load currentPath={basePath} locale={currentLocale} />
    <main class="site-main">
      <slot />
      <footer class="site-footer">
        <div><span>© 2016-{new Date().getFullYear()} Fibers</span><span>{t('footer.tagline')}</span></div>
        <nav aria-label={t('footer.linksLabel')}>
          <a href={localizePath('/com-funciona/', currentLocale)}>{t('footer.howItWorks')}</a>
          <a href={localizePath('/condicions/', currentLocale)}>{t('footer.terms')}</a>
          <a href={localizePath('/contacte/', currentLocale)}>{t('footer.contact')}</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
