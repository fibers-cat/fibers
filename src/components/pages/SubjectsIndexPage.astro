---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SubjectExplorer from '@/components/SubjectExplorer';
import { fetchSubjects } from '@/services/subjects';
import { fetchSubjectMaterialCounts } from '@/services/subjectMaterialCounts';
import { getLocaleFromUrl, isLocale, localizePath, useTranslations } from '@/i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const subjects = await fetchSubjects();
const materialCounts = await fetchSubjectMaterialCounts();
const breadcrumbs = [
  { href: localizePath('/', locale), label: t('nav.home') },
  { label: t('nav.subjects') },
];
---

<SiteLayout title={t('catalog.meta.title')} description={t('catalog.meta.description')} breadcrumbs={breadcrumbs}>
  <div class="page-content inner-page">
    <header class="page-heading">
      <span class="eyebrow">{t('catalog.eyebrow')}</span>
      <h1>{t('catalog.title')}</h1>
      <p>{t('catalog.lead')}</p>
    </header>
    <SubjectExplorer client:load subjects={subjects} initialMaterialCounts={materialCounts} locale={locale} />
    <div class="catalog-disclaimer">
      <strong>{t('catalog.disclaimerTitle')}</strong>
      <span>{t('catalog.disclaimer')}</span>
    </div>
  </div>
</SiteLayout>
