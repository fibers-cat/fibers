---
import SiteLayout from '@/layouts/SiteLayout.astro';
// import SiteBreadcrumbs from '../components/SiteBreadcrumbs';
import { getDictionary, getLocaleFromUrl, isLocale, useTranslations } from '@/i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const steps = getDictionary(locale).guide.steps;
---

<SiteLayout title={t('guide.meta.title')} description={t('guide.meta.description')}>
  <div class="page-content inner-page">
    <!-- <SiteBreadcrumbs items={[{ href: '/', label: 'Inici' }, { label: 'Com funciona' }]} /> -->
    <header class="page-heading"><span class="eyebrow">{t('guide.eyebrow')}</span><h1>{t('guide.titleLine1')}<br />{t('guide.titleLine2')}</h1><p>{t('guide.lead')}</p></header>
    <div class="guide-grid">
      {steps.map((step, index) => (
        <article class="guide-card">
          <span class="guide-number">{String(index + 1).padStart(2, '0')}</span>
          <h2>{step.title}</h2>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</SiteLayout>
