---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SubjectExplorer from "@/components/SubjectExplorer";
import UploadFileRoundedIcon from "@mui/icons-material/UploadFileRounded";
import { fetchSubjects } from "@/services/subjects";
import { fetchLatestMaterialDates, fetchSubjectMaterialCounts } from "@/services/subjectMaterialCounts";
import { getLocaleFromUrl, isLocale, localizePath, useTranslations } from "@/i18n";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const [subjects, materialCounts, latestMaterialDates] = await Promise.all([
  fetchSubjects(),
  fetchSubjectMaterialCounts(),
  fetchLatestMaterialDates(),
]);
---

<SiteLayout title={t('home.meta.title')} description={t('home.meta.description')}>
  <div class="page-content home-page">
    <section class="hero-panel">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span> {t('home.eyebrow')}
        </div>
        <h1>{t('home.titleLine1')}<br /><span>{t('home.titleLine2')}</span></h1>
        <p>{t('home.lead')}</p>
        <div class="hero-actions">
          <a class="button-primary" href={localizePath('/assignatures/', locale)}
            >{t('home.exploreCta')} <span aria-hidden="true">→</span></a
          >
          <a class="button-secondary" href={localizePath('/aporta/', locale)}
            >{t('home.shareCta')}</a
          >
        </div>
        <div class="hero-footnote">
          <span class="status-pulse"></span> {t('home.footnote')}
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <div class="art-sheet sheet-back">
          <span></span><span></span><span></span><b>FIB</b>
        </div>
        <div class="art-sheet sheet-front">
          <div class="sheet-mark">f.</div><span></span><span></span><span
          ></span><span></span><div class="sheet-sticker">
            {t('home.stickerLine1')}<br />{t('home.stickerLine2')}
          </div>
        </div>
        <div class="art-tag tag-one">F · M2 · BD</div>
        <div class="art-tag tag-two">{t('home.tagTwo')}</div>
        <div class="art-star star-one">✳</div><div class="art-star star-two">
          ✦
        </div>
      </div>
    </section>

    <section class="section-block" aria-labelledby="subjects-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{t('home.catalogEyebrow')}</span><h2 id="subjects-heading">
            {t('home.catalogTitle')}
          </h2><p>{t('home.catalogLead')}</p>
        </div>
        <a class="button-secondary catalog-header-action" href={localizePath('/assignatures/', locale)}>
          {t('home.catalogCta')} <span aria-hidden="true">→</span>
        </a>
      </div>
      <SubjectExplorer client:load subjects={subjects} featured initialMaterialCounts={materialCounts} initialLatestMaterialDates={latestMaterialDates} locale={locale} />
      <p class="data-note">{t('home.dataNote')}</p>
      <div class="catalog-preview-action">
        <a class="button-primary" href={localizePath('/assignatures/', locale)}>
          {t('home.catalogCta')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="share-banner">
      <div class="share-icon" aria-hidden="true"><UploadFileRoundedIcon /></div>
      <div>
        <h2>{t('home.shareTitle')}</h2><p>{t('home.shareLead')}</p>
      </div>
      <a class="button-primary" href={localizePath('/aporta/', locale)}
        >{t('home.shareButton')} <span aria-hidden="true">→</span></a
      >
    </section>
  </div>
</SiteLayout>

<style>
  .catalog-preview-action {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  @media (max-width: 760px) {
    .catalog-header-action {
      align-self: flex-end;
    }
  }
</style>
