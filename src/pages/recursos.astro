---
import SiteLayout from '@/layouts/SiteLayout.astro';
// import SiteBreadcrumbs from '@/components/shared/SiteBreadcrumbs';
import ResourceCollection from '@/components/ResourceCollection';
import { generalMaterials } from '@/data/materials';
import { fetchMaterialAttributions } from '@/lib/materialAttributions';
import { getLocaleFromUrl, isLocale, useTranslations } from '@/i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const attributions = await fetchMaterialAttributions(generalMaterials);
---

<SiteLayout title={t('resources.meta.title')} description={t('resources.meta.description')}>
  <div class="page-content inner-page">
    <!-- <SiteBreadcrumbs items={[{ href: '/', label: 'Inici' }, { label: 'Recursos generals' }]} /> -->
    <header class="page-heading">
      <span class="eyebrow">{t('resources.eyebrow')}</span>
      <h1>{t('resources.title')}</h1>
      <p>{t('resources.lead')}</p>
    </header>
    <ResourceCollection client:load materials={generalMaterials} attributions={attributions} locale={locale} />
    <p class="data-note">{t('resources.dataNote')}</p>
  </div>
</SiteLayout>
