---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getLocaleFromUrl, isLocale, localizePath, useTranslations } from '@/i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<SiteLayout title={t('notFound.meta.title')} description={t('notFound.meta.description')} noindex>
  <div class="page-content inner-page not-found-page"><span class="error-code">404</span><h1>{t('notFound.titleLine1')}<br />{t('notFound.titleLine2')}</h1><p>{t('notFound.lead')}</p><a class="button-primary" href={localizePath('/', locale)}>{t('notFound.cta')} <span aria-hidden="true">→</span></a></div>
</SiteLayout>
