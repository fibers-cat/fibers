---
import SiteLayout from "@/layouts/SiteLayout.astro";
// import SiteBreadcrumbs from '../../components/SiteBreadcrumbs';
import SubjectExplorer from "@/components/SubjectExplorer";
import { fetchSubjects } from "@/lib/subjects";
import { fetchSubjectMaterialCounts } from "@/lib/subjectMaterialCounts";

const subjects = await fetchSubjects();
const materialCounts = await fetchSubjectMaterialCounts();
---

<SiteLayout
  title="Assignatures de la FIB"
  description="Explora les assignatures de la FIB per nom o acrònim i troba els materials d’estudi recuperats per a cada matèria al catàleg de Fibers."
>
  <div class="page-content inner-page">
    <!-- <SiteBreadcrumbs items={[{ href: '/', label: 'Inici' }, { label: 'Assignatures' }]} /> -->
    <header class="page-heading">
      <span class="eyebrow">CATÀLEG FIB</span>
      <h1>Assignatures</h1>
      <p>
        Busca per nom o acrònim i entra a cada assignatura per consultar els
        fitxers recuperats.
      </p>
    </header>
    <SubjectExplorer client:load subjects={subjects} initialMaterialCounts={materialCounts} showCategoryFilter />
    <div class="catalog-disclaimer">
      <strong>Catàleg històric</strong>
      <span
        >Els fitxers estan associats a la seva assignatura. Revisa la data i la vigència del contingut abans d'utilitzar-los.</span>
    </div>
  </div>
</SiteLayout>
